<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Instacord</RootNamespace>
    <AssemblyName>Instacord</AssemblyName>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Instacord.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetCord" Version="1.0.0-beta.15" />
    <PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.15" />
    <PackageReference Include="NetCord.Hosting.AspNetCore" Version="1.0.0-beta.15" />
    <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.15" />
    <PackageReference Include="NetCord.Services" Version="1.0.0-beta.15" />
    <PackageReference Include="Minio" Version="6.0.4" />
  </ItemGroup>

</Project>